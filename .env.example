# PullHire — локальная конфигурация (12-factor, docs/deployment.md §4).
# Скопируйте в .env:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env в .gitignore; секреты в репозиторий не попадают. Значения ниже — только плейсхолдеры.

# --- PostgreSQL: единый инстанс TOPOLOGY A (docs/architecture.md §5.2) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pullhire
POSTGRES_SUPERUSER=pullhire_admin
POSTGRES_SUPERPASSWORD=change-me-superuser

# --- Роль и пароль на схему (по одному на сервис) ---
AUTH_DB_ROLE=auth_service
AUTH_DB_PASSWORD=change-me-auth
CANDIDATE_DB_ROLE=candidate_service
CANDIDATE_DB_PASSWORD=change-me-candidate
FSP_DB_ROLE=fsp_service
FSP_DB_PASSWORD=change-me-fsp
ASSESSMENT_DB_ROLE=assessment_service
ASSESSMENT_DB_PASSWORD=change-me-assessment
SELECTION_DB_ROLE=selection_service
SELECTION_DB_PASSWORD=change-me-selection
EMPLOYER_DB_ROLE=employer_service
EMPLOYER_DB_PASSWORD=change-me-employer
OUTREACH_DB_ROLE=outreach_service
OUTREACH_DB_PASSWORD=change-me-outreach
NOTIFICATION_DB_ROLE=notification_service
NOTIFICATION_DB_PASSWORD=change-me-notification

# --- JDBC URL сервисов (schema-per-service, без cross-schema доступа) ---
AUTH_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=auth
CANDIDATE_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=candidate
FSP_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=fsp
ASSESSMENT_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=assessment
SELECTION_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=selection
EMPLOYER_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=employer
OUTREACH_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=outreach
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/pullhire?currentSchema=notification

# --- RabbitMQ (брокер событий + Management UI) ---
RABBITMQ_DEFAULT_USER=pullhire
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq

# --- JWT RS256 (auth-service; ключи создаются в S1, docs/architecture.md §6.1) ---
JWT_PRIVATE_KEY=change-me-private-key
JWT_PUBLIC_KEY=change-me-public-key

# --- Локальная проверка JWT по JWKS (notification-service и др. сервисы, docs/architecture.md §6.1) ---
AUTH_JWKS_URL=http://auth-service:8080/.well-known/jwks.json

# --- fsp-service: внутреннее сопоставление sub → candidate.profiles.id (docs/fsp_integration.md §2) ---
CANDIDATE_INTERNAL_URL=http://candidate-service:8080

# --- Публичный базовый URL SPA (ссылки в письмах; notification-service) ---
APP_BASE_URL=http://localhost:3000

# --- SMTP (dev = Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@pullhire.local

# --- candidate-service: файлы резюме и лимит загрузки (S3) ---
CANDIDATE_FILES_DIR=/app/files
CANDIDATE_RESUME_MAX_BYTES=5242880
CANDIDATE_RESUME_REQUEST_MAX_BYTES=6291456

# --- TLS шлюза: self-signed генерируется при старте контейнера (docs/architecture.md §3.2) ---
GATEWAY_TLS_CERT=/etc/nginx/certs/server.crt
GATEWAY_TLS_KEY=/etc/nginx/certs/server.key

# --- Порты хоста демонстрации (docs/deployment.md §3) ---
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
FRONTEND_PORT=3000
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- Порты заглушек на хосте (проверка /healthz в S0; внутри сети — всегда :8080) ---
AUTH_PORT=8081
CANDIDATE_PORT=8082
FSP_PORT=8083
ASSESSMENT_PORT=8084
SELECTION_PORT=8085
EMPLOYER_PORT=8086
OUTREACH_PORT=8087
NOTIFICATION_PORT=8088
